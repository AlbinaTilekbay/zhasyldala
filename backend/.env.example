# Copy to .env and adjust. All of these have safe local-dev defaults —
# you only need to set what you're changing.

DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Almaty

# Leave unset to use sqlite (backend/db.sqlite3). Set all four to use
# Postgres (docker-compose sets these automatically).
# POSTGRES_DB=zhasyldala
# POSTGRES_USER=zhasyldala
# POSTGRES_PASSWORD=zhasyldala
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# Leave unset for a local redis-less dev run — Celery tasks then execute
# inline (CELERY_TASK_ALWAYS_EAGER). Set this once you run `docker compose
# up` or a real worker.
# REDIS_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=False

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pl@ntNet is a *secondary* species-confirmation signal only (see
# apps/ml/plantnet.py) — leave blank until you have a key from
# https://my.plantnet.org/ ; the app works fully without it.
PLANTNET_API_KEY=
PLANTNET_PROJECT=k-world-flora

# Optional, paid, secondary diagnosis source for crops the custom model
# has no training data for (cucumber, eggplant, greens, ...) — see
# apps/ml/kindwise.py. No free tier: https://www.kindwise.com/pricing.
# Leave blank to skip it entirely; the app works fully without it, those
# crops just stay on the neutral "not trained yet" result until you either
# set this or add real photos through the admin training page.
KINDWISE_API_KEY=

# Same idea, but for the anonymous home-plant flow (any houseplant, no
# crop selected — an orchid, a succulent, ...) — see
# apps/ml/plant_health.py. A *separate* key from a separate signup at
# https://www.kindwise.com/plant-health (check there whether your account
# unifies billing with KINDWISE_API_KEY above — not assumed here). No
# free tier. Leave blank to skip; the home-plant flow works fully without
# it, just without a real diagnosis for plants the custom model doesn't
# know (currently: anything that isn't tomato/pepper/strawberry).
KINDWISE_HEALTH_API_KEY=

ML_VIDEO_SAMPLE_FRAMES=3
ML_TRAIN_EPOCHS=6
ML_TRAIN_BATCH_SIZE=16

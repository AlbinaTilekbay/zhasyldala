# Copy to .env and adjust. All of these have safe local-dev defaults —
# you only need to set what you're changing.

DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Almaty

# Leave unset to use sqlite (backend/db.sqlite3). Set all four to use
# Postgres (docker-compose sets these automatically).
# POSTGRES_DB=zhasyldala
# POSTGRES_USER=zhasyldala
# POSTGRES_PASSWORD=zhasyldala
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# Leave unset for a local redis-less dev run — Celery tasks then execute
# inline (CELERY_TASK_ALWAYS_EAGER). Set this once you run `docker compose
# up` or a real worker.
# REDIS_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=False

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Primary diagnosis engine (see apps/ml/openai_vision.py) — the photo is
# sent straight to an OpenAI vision model, which identifies the plant and
# its condition and writes the result-screen cards (cause, treatment
# steps, prevention tips, encouragement) in one call. Leave blank to skip
# it entirely; apps/ml/services.py then falls back to the offline
# PlantVillage-trained model (works with no internet, just narrower —
# currently only tomato/pepper/strawberry, until you add more via the
# admin training page). This is billed API usage, separate from a ChatGPT
# Plus subscription — get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

ML_VIDEO_SAMPLE_FRAMES=3
ML_TRAIN_EPOCHS=6
ML_TRAIN_BATCH_SIZE=16
